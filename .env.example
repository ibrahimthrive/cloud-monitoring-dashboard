# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-secret-value
PORT=5000

# Database
DATABASE_URL=sqlite:///instance/monitoring.db

# Metrics collection
METRICS_COLLECTION_INTERVAL_SECONDS=15
METRICS_RETENTION_DAYS=7
LIVE_REFRESH_INTERVAL_SECONDS=5

# Alert thresholds (defaults; can be changed by an admin in the UI)
DEFAULT_CPU_ALERT_THRESHOLD=85
DEFAULT_RAM_ALERT_THRESHOLD=85
DEFAULT_DISK_ALERT_THRESHOLD=90
ALERT_COOLDOWN_SECONDS=300

# Email notifications
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
ALERT_EMAIL_RECIPIENTS=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
